{
	"Name": "GitHub Graph",
	"Version": "0.1.0.0",
	"Author": "Malika Pixels",
	"Actions": [
		{
			"Name": "Contribution Graph",
			"UUID": "com.malikacodes.github-graph.graph",
			"Icon": "imgs/actions/graph/icon",
			"Tooltip": "Your recent GitHub contributions. Turn to switch between the graph and this week, press to refresh, tap to open your profile.",
			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/graph.json",
				"TriggerDescription": {
					"Push": "Refresh",
					"Rotate": "Graph or this week",
					"Touch": "Open my GitHub profile"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/dial"
				}
			]
		},
		{
			"Name": "Full-Width Graph",
			"UUID": "com.malikacodes.github-graph.wide",
			"Icon": "imgs/actions/wide/icon",
			"Tooltip": "A whole year across all four dials. Put it on every dial of a page. Turn the first dial to change the year.",
			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/wide.json",
				"TriggerDescription": {
					"Push": "Refresh",
					"Rotate": "Change the year (first dial)",
					"Touch": "Back to the last 12 months"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/dial"
				}
			]
		},
		{
			"Name": "Branch Map",
			"UUID": "com.malikacodes.github-graph.branches",
			"Icon": "imgs/actions/branches/icon",
			"Tooltip": "A repo's branches as a metro map: merged pull requests loop back into main, branches still open run off the end. Turn to pick a branch and read its name, tap to open it on GitHub. Put it on two or more dials set to the same repo to spread it out.",
			"PropertyInspectorPath": "ui/branches.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/graph.json",
				"TriggerDescription": {
					"Rotate": "Pick a branch",
					"Push": "Refresh",
					"Touch": "Open the picked branch on GitHub"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/dial"
				}
			]
		},
		{
			"Name": "Contribution Stats",
			"UUID": "com.malikacodes.github-graph.stats",
			"Icon": "imgs/actions/stats/icon",
			"Tooltip": "Your total contributions this year, and how fresh the data is. Press to refresh.",
			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/stats/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Daily Goal",
			"UUID": "com.malikacodes.github-graph.goal",
			"Icon": "imgs/actions/goal/icon",
			"Tooltip": "A ring that fills up as today's contributions reach your daily goal. Press to refresh.",
			"PropertyInspectorPath": "ui/daily-goal.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/goal/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Streak Counter",
			"UUID": "com.malikacodes.github-graph.streak",
			"Icon": "imgs/actions/streak/icon",
			"Tooltip": "A fire that grows with your contribution streak, with your longest streak underneath. Press to refresh.",
			"PropertyInspectorPath": "ui/streak.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/streak/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Repo",
			"UUID": "com.malikacodes.github-graph.repo",
			"Icon": "imgs/actions/repo/icon",
			"Tooltip": "The repo every GitHub key follows. Press to step to the next repo, newest push first.",
			"PropertyInspectorPath": "ui/repo-key.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/repo/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Pull Requests",
			"UUID": "com.malikacodes.github-graph.pulls",
			"Icon": "imgs/actions/pulls/icon",
			"Tooltip": "Open pull requests on the repo. Press to open them on GitHub.",
			"PropertyInspectorPath": "ui/github-key.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/pulls/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Issues",
			"UUID": "com.malikacodes.github-graph.issues",
			"Icon": "imgs/actions/issues/icon",
			"Tooltip": "Open issues on the repo. Press to open them on GitHub.",
			"PropertyInspectorPath": "ui/github-key.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/issues/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Workflow",
			"UUID": "com.malikacodes.github-graph.workflow",
			"Icon": "imgs/actions/workflow/icon",
			"Tooltip": "The latest GitHub Actions run on the repo. Press to open it on GitHub.",
			"PropertyInspectorPath": "ui/github-key.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/workflow/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Repo Stats",
			"UUID": "com.malikacodes.github-graph.stats-repo",
			"Icon": "imgs/actions/stats-repo/icon",
			"Tooltip": "Stars, forks, watchers or the main language of the repo. Press to open that page on GitHub.",
			"PropertyInspectorPath": "ui/repo-stats.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/stats-repo/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Commit Activity",
			"UUID": "com.malikacodes.github-graph.commits",
			"Icon": "imgs/actions/commits/icon",
			"Tooltip": "Commits on the repo's main branch, week by week. Press to open the history on GitHub.",
			"PropertyInspectorPath": "ui/github-key.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/commits/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Branch Comparison",
			"UUID": "com.malikacodes.github-graph.compare",
			"Icon": "imgs/actions/compare/icon",
			"Tooltip": "How far one branch has moved from another. Press to open the comparison on GitHub.",
			"PropertyInspectorPath": "ui/compare.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/compare/key",
					"ShowTitle": false
				}
			]
		}
	],
	"Category": "GitHub Graph",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Shows my GitHub contributions on a Stream Deck: graphs on the dials, a map of a repo's branches, and stats, a daily goal and a streak on the keys.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.malikacodes.github-graph"
}
