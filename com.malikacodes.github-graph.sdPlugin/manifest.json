{
	"Name": "GitHub Graph",
	"Version": "0.1.0.0",
	"Author": "Malika Pixels",
	"Actions": [
		{
			"Name": "Contribution Graph",
			"UUID": "com.malikacodes.github-graph.graph",
			"Icon": "imgs/actions/graph/icon",
			"Tooltip": "Shows your GitHub contribution graph. Turn to change the time range, press to refresh, tap to open your profile.",
			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/graph.json",
				"TriggerDescription": {
					"Push": "Refresh",
					"Rotate": "Change the time range",
					"Touch": "Open my GitHub profile"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/graph/icon"
				}
			]
		},
		{
			"Name": "Full-Width Graph",
			"UUID": "com.malikacodes.github-graph.wide",
			"Icon": "imgs/actions/wide/icon",
			"Tooltip": "A whole year across all four dials. Put it on every dial of a page. Turn the first dial to change the year.",
			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Encoder"
			],
			"Encoder": {
				"layout": "layouts/wide.json",
				"TriggerDescription": {
					"Push": "Refresh",
					"Rotate": "Change the year (first dial)",
					"Touch": "Back to the last 12 months"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/wide/icon"
				}
			]
		},
		{
			"Name": "Contribution Stats",
			"UUID": "com.malikacodes.github-graph.stats",
			"Icon": "imgs/actions/stats/icon",
			"Tooltip": "Your total contributions this year, and how fresh the data is. Press to refresh.",
			"PropertyInspectorPath": "ui/settings.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/stats/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Daily Goal",
			"UUID": "com.malikacodes.github-graph.goal",
			"Icon": "imgs/actions/goal/icon",
			"Tooltip": "A ring that fills up as today's contributions reach your daily goal. Press to refresh.",
			"PropertyInspectorPath": "ui/daily-goal.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/goal/key",
					"ShowTitle": false
				}
			]
		}
	],
	"Category": "GitHub Graph",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Shows my GitHub contributions on a Stream Deck: a graph on the dials and stats on a key.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.malikacodes.github-graph"
}
